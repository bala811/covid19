{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf19proejct"
		},
		"ds_processed_hospital_admissions_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ds_processed_hospital_admissions'"
		},
		"ls_population_destination_adls2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_population_destination_adls2'"
		},
		"ls_population_source_sa_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_population_source_sa'"
		},
		"HttpServer_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().base_url}"
		},
		"ds_processed_hospital_admissions_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://covid19adlsgen2.dfs.core.windows.net/"
		},
		"ls_population_destination_adls2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://covid19adlsgen2.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf19proejct_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ds_processed_hospital_admissions_accountKey": {
						"value": "[parameters('ds_processed_hospital_admissions_accountKey')]"
					},
					"ls_population_destination_adls2_accountKey": {
						"value": "[parameters('ls_population_destination_adls2_accountKey')]"
					},
					"ls_population_source_sa_connectionString": {
						"value": "[parameters('ls_population_source_sa_connectionString')]"
					},
					"HttpServer_properties_typeProperties_url": {
						"value": "[parameters('HttpServer_properties_typeProperties_url')]"
					},
					"ds_processed_hospital_admissions_properties_typeProperties_url": {
						"value": "[parameters('ds_processed_hospital_admissions_properties_typeProperties_url')]"
					},
					"ls_population_destination_adls2_properties_typeProperties_url": {
						"value": "[parameters('ls_population_destination_adls2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}